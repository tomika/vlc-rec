{
  "interface": 1,
  "id": "osc",
  "name": "OBSBOT OSC",
  "version": "0.1.0",
  "command": {
    "win_x64": [
      "osc-win_x64.exe"
    ],
    "linux_x64": [
      "./osc-linux_x64"
    ]
  },
  "config": [
    {
      "key": "host",
      "label": "Camera address",
      "type": "string",
      "required": true
    },
    {
      "key": "hfov",
      "label": "Horizontal field of view at zoom 0, degrees",
      "type": "number",
      "default": 76
    },
    {
      "key": "zoomRatio",
      "label": "Zoom ratio at the top of the zoom range",
      "type": "number",
      "default": 4.6
    },
    {
      "key": "zoomMax",
      "label": "Top of the zoom range, in the camera's percent units",
      "type": "int",
      "default": 36
    },
    {
      "key": "nudgeSpeed",
      "label": "Speed of discrete steps, degrees per second",
      "type": "int",
      "default": 30
    },
    {
      "key": "oscPort",
      "label": "OSC port of the camera",
      "type": "int",
      "default": 57110
    },
    {
      "key": "localPort",
      "label": "Port the camera answers to on this computer",
      "type": "int",
      "default": 57120
    },
    {
      "key": "driveSpeed",
      "label": "Continuous turning speed, percent (Shift: five times faster)",
      "type": "int",
      "default": 20
    }
  ]
}
