{
  "name": "vlc-rec-neutralino",
  "version": "0.1.0",
  "private": true,
  "description": "VLC Stream Recorder ported from Python Tkinter to NeutralinoJS",
  "main": "src/frontend/app.js",
  "scripts": {
    "neu:update": "neu update",
    "start": "neu run",
    "dev": "neu run",
    "build": "neu build",
    "package": "neu build --release --embed-resources && node scripts/postpackage-linux-launchers.js",
    "package:clean": "neu build --clean --release --embed-resources && node scripts/postpackage-linux-launchers.js",
    "postinstall": "neu update"
  },
  "devDependencies": {
    "@neutralinojs/neu": "^11.7.1"
  }
}
